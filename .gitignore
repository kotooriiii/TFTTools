# ==============================================================================
# Claude Code Configuration (.gitignore)
# ==============================================================================

# 1. Ignore all private local settings, cache, and history
.claude/settings.local.json
.claude.json
.claude.json.backup.*
.claude/history.jsonl
.claude/backups/
.claude/cache/
.claude/debug/

# 2. Prevent git from tracking automated conversation logs
.claude/sessions/

# 3. Explicitly allow sharing team-wide guidelines and shared configurations
!.claude/
!.claude/settings.json
!.claude/CLAUDE.md
!CLAUDE.md
!.claude/commands/
